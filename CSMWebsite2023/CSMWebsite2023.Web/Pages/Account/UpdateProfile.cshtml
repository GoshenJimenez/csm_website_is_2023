@page "/account/update-profile"
@model CSMWebsite2023.Web.Pages.Account.UpdateProfile
@{
}


<div class="card">
    <div class="card-body">
        Update your user information.

        <form method="Post">
            <div class="form-group">
                <p class="card-text">@Model.EmailAddress</p>
                <p class="card-text">@Model.Role</p>
                <input type="hidden" value="@Model.UserId" asp-for="@Model.UserId"/>
            </div>
            <hr/>
            <div class="form-group">
                <label for="firstName" asp-for="FirstName">First Name</label>
                <input type="text" class="form-control" id="firstName" aria-describedby="firstNameHelp" placeholder="Enter first name" asp-for="FirstName" value="@Model.FirstName">
                <small id="firstNameHelp" class="form-text text-muted" asp-for="FirstName">First Name is required.</small>
            </div>
            <div class="form-group">
                <label for="lastName" asp-for="LastName">Last Name</label>
                <input type="text" class="form-control" id="lastName" aria-describedby="lastNameHelp" placeholder="Enter last name" asp-for="LastName" value="@Model.LastName">
                <small id="lastNameHelp" class="form-text text-muted" asp-for="LastName">Last Name is required.</small>
            </div>
            <button type="submit" class="btn btn-primary">Submit</button>
        </form>
    </div>
</div>