@page
@model CSMWebsite2023.Web.Pages.Account.ChangePassword
@{
}

<form method="Post">
    <div class="mb-3">
        <label for="oldPassword" class="form-label">Old Password</label>
        <input type="password" class="form-control" id="oldPassword" asp-for="@Model.OldPassword">
    </div>
    <hr />
    <div class="mb-3">
        <label for="newPassword" class="form-label">New Password</label>
        <input type="password" class="form-control" id="newPassword" asp-for="@Model.NewPassword">
    </div>
    <div class="mb-3">
        <label for="confirmNewPassword" class="form-label">Confirm New Password</label>
        <input type="password" class="form-control" id="confirmNewPassword" asp-for="@Model.ConfirmNewPassword">
    </div>
    <hr />
    <button type="submit" class="btn btn-primary">Submit</button>
</form>